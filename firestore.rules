rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSelf(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'realName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'realName', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.realName is string
        && data.realName.size() == 2
        && data.realName.matches('^[가-힣]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list, delete: if false;
      allow create: if isSelf(uid) && validProfile(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid) && validProfile(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function calendarUser() {
      return request.auth != null && isSelf(request.auth.uid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName.matches('^[가-힣]{2}$');
    }

    function calendarAdmin() {
      return exists(/databases/$(database)/documents/calendarAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/calendarAdmins/$(request.auth.uid)).data.enabled == true;
    }

    function validCalendarDate(value) {
      // 형식을 먼저 검사한다. 불완전한 입력은 분할·정수 변환하지 않는다.
      return value is string
        && value.matches('^[1-9][0-9]{3}-[0-9]{2}-[0-9]{2}$')
        && validCalendarDateParts(value.split('-'));
    }

    function validCalendarDateParts(parts) {
      // validCalendarDate의 형식 검사를 통과한 세 개의 숫자 문자열만 받는다.
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let maxDay = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
      return month >= 1 && month <= 12 && day >= 1 && day <= maxDay;
    }

    function validEntry(vessel, entryId) {
      let d = request.resource.data;
      return vessel in ['101', '103']
        && d.keys().hasAll(['schemaVersion', 'date', 'kind', 'content', 'authorUid', 'authorName', 'createdAt', 'updatedAt', 'revision'])
        && d.keys().hasOnly(['schemaVersion', 'date', 'kind', 'content', 'authorUid', 'authorName', 'createdAt', 'updatedAt', 'revision'])
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.date is string && validCalendarDate(d.date)
        && d.kind in ['planned', 'unavailable', 'memo']
        && ((d.kind == 'memo' && entryId.matches('^memo_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'))
          || (d.kind in ['planned', 'unavailable'] && entryId == 'status_' + d.date))
        && d.content is string && d.content.size() > 0 && d.content.size() <= 2000
        // ASCII 공백과 Unicode 구분 공백·세로 탭·BOM만 있는 내용은 거부한다.
        && d.content.matches('[\\s\\S]*[^\\s\\p{Z}\\x{000B}\\x{FEFF}][\\s\\S]*')
        && d.authorUid is string && d.authorName is string && d.authorName.matches('^[가-힣]{2}$')
        && d.createdAt is timestamp && d.updatedAt == request.time
        && d.revision is int && d.revision >= 1;
    }

    match /calendarVessels/{vessel}/entries/{entryId} {
      allow read: if calendarUser() && vessel in ['101', '103'];
      allow create: if calendarUser() && validEntry(vessel, entryId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if calendarUser() && validEntry(vessel, entryId)
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'content', 'updatedAt', 'revision'])
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if calendarUser() && vessel in ['101', '103']
        && (resource.data.authorUid == request.auth.uid || calendarAdmin());
    }

    match /calendarAdmins/{uid} {
      allow get: if calendarUser() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // 공지 관리자 설정은 단일 문서·단일 UID로만 관리한다. 클라이언트 변경은 금지한다.
    function announcementAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/appSettings/announcements)
        && get(/databases/$(database)/documents/appSettings/announcements).data.adminUid is string
        && get(/databases/$(database)/documents/appSettings/announcements).data.adminUid == request.auth.uid;
    }

    function validAnnouncement() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'title', 'body', 'published', 'sortOrder', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'revision'])
        && d.keys().hasOnly(['schemaVersion', 'title', 'body', 'published', 'sortOrder', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'revision'])
        && d.schemaVersion is int && d.schemaVersion == 1
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.title.matches('[\\s\\S]*[^\\s\\p{Z}\\x{000B}\\x{FEFF}][\\s\\S]*')
        && d.body is string && d.body.size() > 0 && d.body.size() <= 10000
        && d.body.matches('[\\s\\S]*[^\\s\\p{Z}\\x{000B}\\x{FEFF}][\\s\\S]*')
        && d.published is bool && d.sortOrder is int && d.sortOrder >= 0 && d.sortOrder <= 9999
        && d.createdBy is string && d.updatedBy == request.auth.uid
        && d.createdAt is timestamp && d.updatedAt == request.time
        && d.revision is int && d.revision >= 1;
    }

    match /appSettings/announcements {
      allow get: if calendarUser();
      allow list, create, update, delete: if false;
    }

    match /announcements/{noticeId} {
      allow read: if calendarUser() && (resource.data.published == true || announcementAdmin());
      allow create: if calendarUser() && announcementAdmin() && validAnnouncement()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if calendarUser() && announcementAdmin() && validAnnouncement()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'published', 'sortOrder', 'updatedBy', 'updatedAt', 'revision'])
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if calendarUser() && announcementAdmin();
    }

    // 행위허가: 기존 calendarUser/calendarAdmin을 재사용하며 기존 경로는 변경하지 않는다.
    function monthDays(y, m) {
      return m == 2 ? ((y % 400 == 0 || (y % 4 == 0 && y % 100 != 0)) ? 29 : 28) : (m in [4,6,9,11] ? 30 : 31);
    }
    function permitExpiry(date) {
      let p = date.split('-');
      let y = int(p[0]) + (int(p[1]) == 12 ? 1 : 0);
      let m = int(p[1]) == 12 ? 1 : int(p[1]) + 1;
      let d = int(p[2]) <= monthDays(y, m) ? int(p[2]) : monthDays(y, m);
      return timestamp.date(y, m, d) - duration.value(9, 'h');
    }
    function validPermitVertices(v) {
      // Firestore 규칙은 반복문이 없으므로 크기를 제한한다.
      // 각 좌표의 DMS·범위·일치·다각형 교차 검사는 클라이언트 저장 및 읽기에서 검사한다.
      return v is list && v.size() >= 4 && v.size() <= 20;
    }
    function validPermitSnapshot(p) {
      return p is map && p.keys().hasAll(['permitNumber','target','sourceCrs','vertices','startDate','endDate'])

        && p.permitNumber is string && p.permitNumber.size() > 0 && p.permitNumber.size() <= 120
        && p.target is string && p.target.size() > 0 && p.target.size() <= 80
        && p.sourceCrs == 'EPSG:4326' && validPermitVertices(p.vertices)
        && validCalendarDate(p.startDate) && validCalendarDate(p.endDate) && p.startDate <= p.endDate;
    }
    function snapshotOf(p) {
      return {'permitNumber':p.permitNumber,'target':p.target,'sourceCrs':p.sourceCrs,'vertices':p.vertices,'startDate':p.startDate,'endDate':p.endDate};
    }
    function validPermit() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion','permitNumber','target','sourceCrs','vertices','startDate','endDate','notes','expiresAt','authorUid','authorName','createdAt','updatedAt','revision'])
        && d.keys().hasOnly(['schemaVersion','permitNumber','target','sourceCrs','vertices','startDate','endDate','notes','expiresAt','authorUid','authorName','createdAt','updatedAt','revision'])
        && d.schemaVersion == 1 && validPermitSnapshot(d)
        && d.notes is string && d.notes.size() <= 2000
        && d.expiresAt is timestamp && d.expiresAt == permitExpiry(d.endDate)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && d.authorUid is string && d.authorName is string && d.authorName.matches('^[가-힣]{2}$')
        && d.revision is int && d.revision >= 1;
    }
    match /activityPermits/{id} {
      allow read: if calendarUser();
      allow create: if calendarUser() && validPermit()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if calendarUser() && resource.data.authorUid == request.auth.uid && validPermit()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permitNumber','target','sourceCrs','vertices','startDate','endDate','notes','expiresAt','updatedAt','revision'])
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if calendarUser() && (resource.data.authorUid == request.auth.uid || calendarAdmin());
    }
    function validInvestigation() {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion','permitId','permitSnapshot','date','vessel','status','authorUid','authorName','createdAt','updatedAt','revision'])
        && d.keys().hasOnly(['schemaVersion','permitId','permitSnapshot','date','vessel','status','authorUid','authorName','createdAt','updatedAt','revision'])
        && d.schemaVersion == 1 && d.permitId is string && d.permitId.size() > 0 && d.permitId.size() <= 128
        && d.vessel in ['101','103'] && d.status in ['planned','completed']
        && validCalendarDate(d.date)
        && d.date >= d.permitSnapshot.startDate && d.date <= d.permitSnapshot.endDate
        && d.authorUid is string && d.authorName is string && d.authorName.matches('^[가-힣]{2}$')
        && d.createdAt is timestamp && d.updatedAt == request.time && d.revision is int && d.revision >= 1;
    }
    function currentPermitSnapshot(d) {
      return exists(/databases/$(database)/documents/activityPermits/$(d.permitId))
        && d.permitSnapshot == snapshotOf(get(/databases/$(database)/documents/activityPermits/$(d.permitId)).data);
    }
    match /permitInvestigations/{id} {
      allow read: if calendarUser();
      allow create: if calendarUser() && validInvestigation() && currentPermitSnapshot(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
      allow update: if calendarUser() && resource.data.authorUid == request.auth.uid && validInvestigation()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','vessel','status','permitSnapshot','updatedAt','revision'])
        && request.resource.data.revision == resource.data.revision + 1
        && (request.resource.data.permitSnapshot == resource.data.permitSnapshot || currentPermitSnapshot(request.resource.data));
      allow delete: if calendarUser() && (resource.data.authorUid == request.auth.uid || calendarAdmin());
    }
    // Shared rock docking data: isolated from calendar and permit collections.
    function rockRange(r) {
      return r == null || (r is map && r.keys().hasAll(['min','max']) && r.keys().hasOnly(['min','max'])
        && r.min is number && r.max is number && r.min >= -2000 && r.max <= 2000 && r.min <= r.max);
    }
    function rockPhoto(index, id, owner) {
      let p = request.resource.data.photos[index];
      return p is map && p.keys().hasOnly(['id','path','role','size','width','height'])
        && p.id is string && p.id.matches('^[0-9a-f-]{36}$') && p.path == 'rockDocking/' + id + '/' + owner + '/' + p.id + '.webp'
        && p.role in ['wide','close','extra'] && p.size is int && p.size > 0 && p.size <= 512000
        && p.width is int && p.width > 0 && p.width <= 1600 && p.height is int && p.height > 0 && p.height <= 1600;
    }
    function rockPhotos(id, owner) {
      let p = request.resource.data.photos;
      let n = p.size();
      let ids = [n > 0 ? p[0].id : '', n > 1 ? p[1].id : '', n > 2 ? p[2].id : '', n > 3 ? p[3].id : ''];
      let roles = [n > 0 ? p[0].role : '', n > 1 ? p[1].role : '', n > 2 ? p[2].role : '', n > 3 ? p[3].role : ''];
      let primary = roles.removeAll(['extra','']);
      return p is list && n <= 4
        && ids.toSet().size() == n + (n < 4 ? 1 : 0)
        && primary.toSet().size() == primary.size() && roles.removeAll(['wide','close','']).size() <= 2
        && (n < 1 || rockPhoto(0, id, owner)) && (n < 2 || rockPhoto(1, id, owner))
        && (n < 3 || rockPhoto(2, id, owner)) && (n < 4 || rockPhoto(3, id, owner));
    }
    function rockPoint(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion','islandId','name','lat','lng','stationCode','datum','ranges','confirmedOn','photos','authorUid','authorName','updatedBy','createdAt','updatedAt','revision','deleted'])
        && d.keys().hasOnly(['schemaVersion','islandId','name','lat','lng','stationCode','datum','ranges','confirmedOn','photos','authorUid','authorName','updatedBy','createdAt','updatedAt','revision','deleted'])
        && d.schemaVersion == 1 && d.islandId is string && exists(/databases/$(database)/documents/rockDockingIslands/$(d.islandId))
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.name.matches('[\\s\\S]*[^\\s\\p{Z}][\\s\\S]*')
        && d.lat is number && d.lat >= -90 && d.lat <= 90 && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.stationCode in ['DT_0014','SO_0552'] && d.datum in ['DL','unverified'] && validCalendarDate(d.confirmedOn)
        && d.ranges is map && d.ranges.keys().hasAll(['101','103']) && d.ranges.keys().hasOnly(['101','103']) && rockRange(d.ranges['101']) && rockRange(d.ranges['103'])
        && d.authorUid is string && d.authorName is string && d.authorName.matches('^[가-힣]{2}$')
        && d.updatedBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
        && d.createdAt is timestamp && d.updatedAt == request.time && d.revision is int && d.revision >= 1 && d.deleted is bool
        && rockPhotos(id,d.authorUid);
    }
    // Existing immutable fields were validated on create; revalidate changed input only.
    // Four photos must fit Firestore's 1,000-expression budget without weakening fields.
    function rockEdits(id) {
      let d = request.resource.data;
      let c = d.diff(resource.data).affectedKeys();
      return (!c.hasAny(['islandId']) || (d.islandId is string && exists(/databases/$(database)/documents/rockDockingIslands/$(d.islandId))))
        && (!c.hasAny(['name']) || (d.name is string && d.name.size() > 0 && d.name.size() <= 80 && d.name.matches('[\\s\\S]*[^\\s\\p{Z}][\\s\\S]*')))
        && (!c.hasAny(['lat']) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!c.hasAny(['lng']) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && (!c.hasAny(['stationCode']) || d.stationCode in ['DT_0014','SO_0552'])
        && (!c.hasAny(['datum']) || d.datum in ['DL','unverified'])
        && (!c.hasAny(['confirmedOn']) || validCalendarDate(d.confirmedOn))
        && (!c.hasAny(['ranges']) || (d.ranges is map && d.ranges.keys().hasAll(['101','103']) && d.ranges.keys().hasOnly(['101','103']) && rockRange(d.ranges['101']) && rockRange(d.ranges['103'])))
        && (!c.hasAny(['photos']) || rockPhotos(id,resource.data.authorUid));
    }
    match /rockDockingIslands/{id} {
      allow read: if calendarUser();
      allow create: if calendarUser() && request.resource.data.keys().hasAll(['name','createdBy','createdAt'])
        && request.resource.data.keys().hasOnly(['name','createdBy','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.matches('^[가-힣A-Za-z0-9·()_-]{1,40}$')
        && id == request.resource.data.name.lower() && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /rockDockingPoints/{id} {
      allow list: if calendarUser() && resource.data.deleted == false;
      allow get: if calendarUser() && (!exists(/databases/$(database)/documents/rockDockingPoints/$(id)) || resource.data.deleted == false || resource.data.authorUid == request.auth.uid || calendarAdmin());
      allow create: if calendarUser() && request.resource.data.photos.size() == 0 && rockPoint(id) && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1 && request.resource.data.deleted == false;
      allow update: if calendarUser() && resource.data.deleted == false
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
        && request.resource.data.revision == resource.data.revision + 1
        && ((resource.data.authorUid == request.auth.uid && request.resource.data.deleted == false && rockEdits(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['islandId','name','lat','lng','stationCode','datum','ranges','confirmedOn','photos','updatedBy','updatedAt','revision']))
          || ((resource.data.authorUid == request.auth.uid || calendarAdmin()) && request.resource.data.deleted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','updatedBy','updatedAt','revision'])));
      allow delete: if false;
      match /notes/{noteId} {
        function parentLive() { return get(/databases/$(database)/documents/rockDockingPoints/$(id)).data.deleted == false; }
        function validNote() {
          let d = request.resource.data;
          return d.keys().hasAll(['text','pinned','authorUid','authorName','createdAt','updatedAt','revision']) && d.keys().hasOnly(['text','pinned','authorUid','authorName','createdAt','updatedAt','revision'])
            && d.text is string && d.text.size() > 0 && d.text.size() <= 4000 && d.text.matches('[\\s\\S]*[^\\s\\p{Z}][\\s\\S]*') && d.pinned is bool
            && d.authorUid is string && d.authorName is string && d.authorName.matches('^[가-힣]{2}$') && d.createdAt is timestamp
            && d.updatedAt == request.time && d.revision is int && d.revision >= 1;
        }
        allow read: if calendarUser() && parentLive();
        allow create: if calendarUser() && getAfter(/databases/$(database)/documents/rockDockingPoints/$(id)).data.deleted == false && validNote()
          && request.resource.data.authorUid == request.auth.uid && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.realName
          && request.resource.data.createdAt == request.time && request.resource.data.revision == 1;
        allow update: if calendarUser() && parentLive() && resource.data.authorUid == request.auth.uid && validNote()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','pinned','updatedAt','revision']) && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if calendarUser() && parentLive() && (resource.data.authorUid == request.auth.uid || calendarAdmin());
      }
    }

    // 명시적으로 허용하지 않은 경로는 기본 거부한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
